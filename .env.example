# Application Configuration
APP_NAME=AI Photo Editor
APP_VERSION=0.1.0
DEBUG=false

# API Configuration
API_V1_PREFIX=/api/v1

# Google Cloud Storage Configuration
# Set CLOUD_STORAGE_BUCKET to enable GCS, otherwise uses local storage
CLOUD_STORAGE_BUCKET=
# Optional: Path to GCS service account JSON key file
# Alternative: Use gcloud auth application-default login
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Local Storage Configuration (fallback if GCS not configured)
LOCAL_STORAGE_PATH=./storage

# Imaginary API Configuration
# Base URL of the Imaginary image processing service
IMAGINARY_BASE_URL=http://localhost:8080
# Timeout for Imaginary API requests (seconds)
IMAGINARY_TIMEOUT=30

# Model Configuration
MODEL_CACHE_DIR=./model_cache
USE_QUANTIZATION=true
MAX_IMAGE_SIZE=2048

# Processing Configuration
TIMEOUT_SECONDS=300
MAX_CONCURRENT_JOBS=5

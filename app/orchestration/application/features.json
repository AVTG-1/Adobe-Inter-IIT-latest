{
    "crop": {
        "description": "Crops the image to a specific region.",
        "params": {
            "x": {"type": "int", "description": "X coordinate of top-left corner", "default": 0},
            "y": {"type": "int", "description": "Y coordinate of top-left corner", "default": 0},
            "w": {"type": "int", "description": "Width of the crop box", "default": 100},
            "h": {"type": "int", "description": "Height of the crop box", "default": 100}
        }
    },
    "rotate": {
        "description": "Rotates the image by a specified angle.",
        "params": {
            "angle": {"type": "float", "description": "Angle in degrees (clockwise)", "default": 0.0}
        }
    },
    "brightness": {
        "description": "Adjusts the brightness of the image.",
        "params": {
            "factor": {"type": "float", "description": "Brightness factor (1.0 is original, <1.0 is darker, >1.0 is brighter)", "default": 1.0, "min": 0.0, "max": 2.0}
        }
    },
    "contrast": {
        "description": "Adjusts the contrast of the image.",
        "params": {
            "factor": {"type": "float", "description": "Contrast factor (1.0 is original)", "default": 1.0, "min": 0.0, "max": 2.0}
        }
    },
    "saturation": {
        "description": "Adjusts the color saturation of the image.",
        "params": {
            "factor": {"type": "float", "description": "Saturation factor (1.0 is original, 0.0 is grayscale)", "default": 1.0, "min": 0.0, "max": 2.0}
        }
    },
    "sharpness": {
        "description": "Adjusts the sharpness of the image.",
        "params": {
            "factor": {"type": "float", "description": "Sharpness factor (1.0 is original)", "default": 1.0, "min": 0.0, "max": 2.0}
        }
    },
    "filter": {
        "description": "Applies a stylistic filter to the image.",
        "params": {
            "type": {"type": "string", "description": "Type of filter", "options": ["sepia", "contrast", "cyberpunk", "grayscale"], "default": "contrast"}
        }
    },
    "overlay": {
        "description": "Adds an overlay effect to the image.",
        "params": {
            "type": {"type": "string", "description": "Type of overlay", "options": ["rain", "sun", "snow"], "default": "rain"}
        }
    },
    "resize": {
        "description": "Resizes the image to specific dimensions.",
        "params": {
            "width": {"type": "int", "description": "Target width", "default": 800},
            "height": {"type": "int", "description": "Target height", "default": 600}
        }
    },
    "relighting": {
        "description": "Re-light the scene given a light source in 3D (x,y,z). Service takes image_url and x,y,z and returns a processed image.",
        "params": {
            "x": {"type": "float", "description": "X coordinate of light source", "default": 0.0},
            "y": {"type": "float", "description": "Y coordinate of light source", "default": -100.0},
            "z": {"type": "float", "description": "Z (depth) coordinate of light source", "default": 100.0}
        }
    }
}
